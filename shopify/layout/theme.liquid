<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-hour="dawn">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f2eadc">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">

  <title>
    {{- page_title -}}
    {%- unless page_title contains shop.name %} — {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if page_image -%}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ 'instrument-serif.woff2' | asset_url }}">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ 'instrument-serif-italic.woff2' | asset_url }}">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ 'newsreader.woff2' | asset_url }}">

  {% style %}
    @font-face { font-family: "Instrument Serif"; font-style: normal; font-weight: 400; font-display: swap; src: url({{ 'instrument-serif.woff2' | asset_url }}) format("woff2"); }
    @font-face { font-family: "Instrument Serif"; font-style: italic; font-weight: 400; font-display: swap; src: url({{ 'instrument-serif-italic.woff2' | asset_url }}) format("woff2"); }
    @font-face { font-family: "Newsreader"; font-style: normal; font-weight: 400 500; font-display: swap; src: url({{ 'newsreader.woff2' | asset_url }}) format("woff2"); }
    @font-face { font-family: "Newsreader"; font-style: italic; font-weight: 400; font-display: swap; src: url({{ 'newsreader-italic.woff2' | asset_url }}) format("woff2"); }
    @font-face { font-family: "Jost"; font-style: normal; font-weight: 400 500; font-display: swap; src: url({{ 'jost.woff2' | asset_url }}) format("woff2"); }
    @font-face { font-family: "Noto Serif Tamil"; font-style: normal; font-weight: 400 500; font-display: swap; src: url({{ 'noto-serif-tamil.woff2' | asset_url }}) format("woff2"); unicode-range: U+0964-0965, U+0B82-0BFA, U+200C-200D, U+20B9, U+25CC; }
  {% endstyle %}

  {{ 'artham.css' | asset_url | stylesheet_tag }}
  <script>document.documentElement.classList.remove('no-js'); document.documentElement.classList.add('js');</script>
  <script src="{{ 'artham.js' | asset_url }}" defer></script>

  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="skip-link" href="#main">Skip to content</a>

  {% sections 'header-group' %}

  <main id="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}
  {% section 'cart-drawer' %}
</body>
</html>
