<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-hour="maalai">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
  {% style %}
    @font-face { font-family: "Instrument Serif"; font-style: normal; font-weight: 400; font-display: swap; src: url({{ 'instrument-serif.woff2' | asset_url }}) format("woff2"); }
    @font-face { font-family: "Instrument Serif"; font-style: italic; font-weight: 400; font-display: swap; src: url({{ 'instrument-serif-italic.woff2' | asset_url }}) format("woff2"); }
    @font-face { font-family: "Newsreader"; font-style: normal; font-weight: 400 500; font-display: swap; src: url({{ 'newsreader.woff2' | asset_url }}) format("woff2"); }
    @font-face { font-family: "Jost"; font-style: normal; font-weight: 400 500; font-display: swap; src: url({{ 'jost.woff2' | asset_url }}) format("woff2"); }
  {% endstyle %}
  {{ 'artham.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="main">{{ content_for_layout }}</main>
</body>
</html>
