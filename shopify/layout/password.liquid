<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-hour="maalai">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
  {% style %}
    @font-face { font-family: "Cormorant Garamond"; font-style: normal; font-weight: 300 700; font-display: swap; src: url({{ 'cormorant-garamond.woff2' | asset_url }}) format("woff2"); }
    @font-face { font-family: "Cormorant Garamond"; font-style: italic; font-weight: 300 700; font-display: swap; src: url({{ 'cormorant-garamond-italic.woff2' | asset_url }}) format("woff2"); }
    @font-face { font-family: "EB Garamond"; font-style: normal; font-weight: 400 500; font-display: swap; src: url({{ 'eb-garamond.woff2' | asset_url }}) format("woff2"); }
    @font-face { font-family: "EB Garamond"; font-style: italic; font-weight: 400 500; font-display: swap; src: url({{ 'eb-garamond-italic.woff2' | asset_url }}) format("woff2"); }
    @font-face { font-family: "Marcellus"; font-style: normal; font-weight: 400; font-display: swap; src: url({{ 'marcellus.woff2' | asset_url }}) format("woff2"); }
  {% endstyle %}
  {{ 'artham.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="main">{{ content_for_layout }}</main>
</body>
</html>
