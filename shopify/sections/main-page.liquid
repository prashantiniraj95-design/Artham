    <p class="label">{{ shop.name }}</p>
    <h1 class="display" style="font-size:clamp(60px,9vw,130px);color:var(--accent);margin:14px 0 46px">{{ page.title }}</h1>
    <div class="rte">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{ "name": "Page", "settings": [] }
{% endschema %}
