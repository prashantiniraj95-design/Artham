<section class="prologue" id="prologue">
  <div class="prologue__grid">
    <div class="prologue__text">
      <p class="label reveal">{{ section.settings.eyebrow }}</p>
      <blockquote class="prologue__quote" data-words>{{ section.settings.quote }}</blockquote>
    </div>

    <figure class="prologue__figure">
      <div class="frame unveil" data-parallax="0.06">
        {% render 'img', image: section.settings.image, fallback: 'craft-rolled-paai.jpg', alt: 'Rolls of dyed korai paai standing on end, bound with wire', sizes: '(min-width: 860px) 32vw, 78vw' %}
      </div>
      <figcaption>{{ section.settings.caption }}</figcaption>
    </figure>

    <div class="prologue__body reveal">
      <h2 class="display">{{ section.settings.heading }}</h2>
      <p class="meaning">{{ section.settings.meaning }}</p>
      <div class="prose">{{ section.settings.text }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Prologue",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line", "default": "Before the collection" },
    { "type": "textarea", "id": "quote", "label": "Opening line", "default": "The paai, a familiar part of every home. Spread out for sleeping, rolled out for festivals and gatherings, then tucked away behind the door until the next time." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Korai grass · rolled and waiting" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Artham" },
    { "type": "text", "id": "meaning", "label": "Meaning", "default": "meaning" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Artham began on paper, patterns drawn from whatever was already in view. Tile. Shadow. Grain. The grid of a window at four in the afternoon.</p><p>Bags came later, and only because the paai was never exotic to us.</p>" }
  ],
  "presets": [{ "name": "Prologue" }]
}
{% endschema %}
