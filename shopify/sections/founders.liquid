<section class="founders" id="founders" data-hour="dawn">
  <div class="founders__grid">
    <header class="founders__head">
      <p class="label reveal">{{ section.settings.eyebrow }}</p>
      <h2 class="display reveal">{{ section.settings.title }}</h2>
    </header>

    {%- if section.blocks.size > 0 -%}
    <div class="founders__portraits">
      {%- for block in section.blocks -%}
        <figure class="founder reveal" {{ block.shopify_attributes }}>
          <div class="founder__frame">{% render 'img', image: block.settings.portrait, fallback: block.settings.fallback, alt: block.settings.name, sizes: '(min-width: 860px) 28vw, 46vw' %}</div>
          <figcaption>
            <h3 class="founder__name">{{ block.settings.name }}</h3>
            <p class="label founder__role">{{ block.settings.role }}</p>
            {%- if block.settings.line != blank -%}<p class="founder__line">{{ block.settings.line }}</p>{%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
    {%- else -%}
    <figure class="founders__photo">
      <div class="frame unveil" data-parallax="0.04">
        {% render 'img', image: section.settings.photo, fallback: 'founders.jpg', alt: section.settings.names, sizes: '(min-width: 860px) 48vw, 100vw' %}
      </div>
      <figcaption class="reveal">
        <span class="founders__names">{{ section.settings.names }}</span>
        <span class="label">{{ section.settings.role }}</span>
      </figcaption>
    </figure>
    {%- endif -%}

    <div class="founders__story reveal">
      <div class="prose">{{ section.settings.text }}</div>
      {%- if section.settings.sign != blank -%}<p class="founders__sign">{{ section.settings.sign }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founders",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line", "default": "The house of Artham" },
    { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Two habits <em>of seeing.</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>One of us reads pattern for a living. The other grew up a short road from the looms, where a mat is simply a mat.</p><p>Between those two habits of seeing, the weave was translated, carried across into a different object with its ordinariness intact.</p>" },
    { "type": "image_picker", "id": "photo", "label": "Photograph of the founders", "info": "Portrait, 4:5. Used when no separate founder blocks are added." },
    { "type": "text", "id": "names", "label": "Names under the photograph", "default": "Dhiraj & Prashantini" },
    { "type": "text", "id": "role", "label": "Line beside the names", "default": "Founders" },
    { "type": "text", "id": "sign", "label": "Signature", "default": "Dhiraj & Prashantini" }
  ],
  "blocks": [
    { "type": "founder", "name": "Founder", "settings": [
      { "type": "image_picker", "id": "portrait", "label": "Portrait", "info": "Portrait, 4:5." },
      { "type": "text", "id": "name", "label": "Name", "default": "Prashantini" },
      { "type": "text", "id": "role", "label": "Role", "default": "Co-founder" },
      { "type": "textarea", "id": "line", "label": "One or two lines" },
      { "type": "text", "id": "fallback", "label": "Theme file for the portrait" } ] }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Founders" }]
}
{% endschema %}
