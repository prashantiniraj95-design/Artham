<section class="film" style="display:grid;place-items:center;text-align:center">
  <div class="film__media"><img src="{{ 'naal-film-poster.jpg' | asset_url }}" alt=""></div>
  <div style="position:relative;z-index:2;padding:0 24px;max-width:560px">
    <span class="logo-mark" style="-webkit-mask-image: url('{{ 'logo-mark.png' | asset_url }}'); mask-image: url('{{ 'logo-mark.png' | asset_url }}'); --logo-fill: linear-gradient(120deg,#f6ead0,#e2c88f); margin:0 auto 30px"></span>
    <h1 class="display" style="font-size:clamp(70px,12vw,170px);font-style:italic">Naal</h1>
    <p style="margin:18px 0 30px">{{ shop.password_message | default: 'Collection One is on the loom. Leave your email and we will write when the day begins.' }}</p>
    {%- form 'customer', class: 'letter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
      <input type="email" name="contact[email]" placeholder="Your email" required aria-label="Email">
      <button type="submit">Write to me</button>
    {%- endform -%}
    <details style="margin-top:34px"><summary class="label" style="color:#e2c88f;cursor:pointer;list-style:none">Enter with password</summary>
      {%- form 'storefront_password', class: 'letter__form' -%}
        <input type="password" name="password" placeholder="Password" aria-label="Password">
        <button type="submit">Enter</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
